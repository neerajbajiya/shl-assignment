# ── Copy this file to .env and fill in your values ──────────────────────────
# .env is gitignored — never commit real keys.

# ── LLM Provider (pick one: groq | gemini | anthropic) ──────────────────────
LLM_PROVIDER=groq

# ── API keys — only the key for your chosen provider is required ─────────────
# Groq  (free): https://console.groq.com  → API Keys
GROQ_API_KEY=gsk_...

# Gemini (free): https://aistudio.google.com → Get API Key
GEMINI_API_KEY=AIza...

# Anthropic (paid): https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Model override (optional — sensible defaults are set per provider) ────────
# LLM_MODEL=llama-3.3-70b-versatile    # groq options: llama3-8b-8192, mixtral-8x7b-32768
# LLM_MODEL=gemini-2.0-flash           # gemini options: gemini-1.5-pro
# LLM_MODEL=claude-sonnet-4-6          # anthropic options: claude-haiku-4-5-20251001

# ── Catalog settings (optional) ──────────────────────────────────────────────
SHL_CATALOG_URL=https://tcp-us-prod-rnd.shl.com/voiceRater/shl-ai-hiring/shl_product_catalog.json
# SHL_CATALOG_CACHE=/tmp/shl_catalog_cache.json   # where to cache the catalog on disk
# SHL_CATALOG_TTL=21600                           # cache lifetime in seconds (default 6h)
